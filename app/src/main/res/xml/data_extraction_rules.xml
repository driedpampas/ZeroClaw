<?xml version="1.0" encoding="utf-8"?>
<!--
  Backs up nothing: mirrors android:allowBackup="false" on Android 12+.
  Both cloud backup and device transfers exclude the entire app data root.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
